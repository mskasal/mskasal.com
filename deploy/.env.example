# Copy to .env with scripts/init-env.sh, which also fills in the secrets.

# --- Domains and TLS ----------------------------------------------------------
PUBLIC_DOMAIN=mskasal.com
# The back office. Pick something hard to guess; Google sign-in still guards it.
ADMIN_DOMAIN=
# acme (public server), tunnel (Cloudflare Tunnel) or internal (local testing).
TLS_MODE=acme
# Derived from TLS_MODE by init-env.sh: http:// for tunnel, https:// otherwise.
CADDY_SCHEME=https://
# Let's Encrypt account e-mail (acme mode).
ACME_EMAIL=
# Kill switches, applied with `docker compose up -d caddy`:
# SITE=soon replaces the whole public site with a "soon!" page;
# RESUME=off takes only the résumé (/) offline and sends visitors to /experiments.
SITE=on
RESUME=on

# --- Status for dashboards (optional) --------------------------------------------
# GET http://<STATUS_BIND>:8090/status (JSON) and /metrics (Prometheus), written by
# scripts/status.py (scripts/install-status.sh runs it every 30 s). Bind it to a
# LAN address only, e.g. 192.168.1.20; the default answers on this machine alone.
STATUS_BIND=127.0.0.1
# Empty: open to anyone who can reach STATUS_BIND. Set: requires "Bearer <token>".
STATUS_TOKEN=

# --- Back office sign-in (oauth2-proxy) ----------------------------------------
# The only Google account that may sign in; init-env.sh writes it to emails.txt.
ALLOWED_EMAIL=mustafasamedkasal@gmail.com
# A Google OAuth client of type "Web application" with the redirect URI
# https://<ADMIN_DOMAIN>/oauth2/callback (see README.md).
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# Filled in by init-env.sh.
OAUTH2_PROXY_COOKIE_SECRET=

# --- Dossier ---------------------------------------------------------------------
DOSSIER_VERSION=v1.9.2
# Filled in by init-env.sh: a hash of your Dossier password, and random secrets.
DOSSIER_PASSWORD=
DOSSIER_SECRET=
POSTGRES_PASSWORD=
TZ=Europe/Berlin

# AI provider: Claude through the Anthropic API.
DOSSIER_AI_PROVIDER=anthropic
DOSSIER_AI_MODEL=claude-sonnet-5-5
DOSSIER_AI_KEY=

# Job search (optional): jsearch or adzuna, with their keys.
DOSSIER_JOBS_SOURCE=
DOSSIER_JSEARCH_KEY=
DOSSIER_ADZUNA_APP_ID=
DOSSIER_ADZUNA_KEY=

# Gmail and Calendar (optional): an OAuth client with the redirect URI
# https://<ADMIN_DOMAIN>/api/google/callback.
DOSSIER_GOOGLE_CLIENT_ID=
DOSSIER_GOOGLE_CLIENT_SECRET=

# --- Home hosting (optional) ------------------------------------------------------
# With TLS_MODE=tunnel: COMPOSE_PROFILES=tunnel and the tunnel's token.
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=
