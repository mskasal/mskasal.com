# TLS_MODE picks one of the snippets below:
#   acme      Let's Encrypt certificates (a public server)
#   internal  Caddy's own CA (testing without a public domain)
#   tunnel    plain HTTP behind Cloudflare Tunnel, which terminates TLS
{
	# cloudflared reaches Caddy from the Docker network; keep the
	# X-Forwarded-Proto it sends (https) instead of overwriting it.
	servers {
		trusted_proxies static private_ranges
	}
}

(tls_acme) {
	tls {$ACME_EMAIL}
}

(tls_internal) {
	tls internal
}

(tls_tunnel) {
}

{$CADDY_SCHEME}{$PUBLIC_DOMAIN} {
	import tls_{$TLS_MODE}
	encode zstd gzip
	# Kill switches, set in .env, then `docker compose up -d caddy`:
	#   SITE=soon   every page answers "soon!" (503, so search engines wait);
	#               /healthz stays up for check.sh.
	#   RESUME=off  only the résumé (/) goes, to /experiments (302).
	@soon expression `{env.SITE} == "soon" && {path} != "/healthz"`
	handle @soon {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		header Retry-After "86400"
		respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>soon!</title><style>html,body{height:100%;margin:0}body{display:grid;place-items:center;font:600 clamp(3rem,12vw,8rem)/1 system-ui,sans-serif;background:#f6f5ef;color:#111}@media (prefers-color-scheme:dark){body{background:#1f1f1a;color:#f6f5ef}}</style></head><body>soon!</body></html>` 503
	}
	@resume_off expression `{env.RESUME} == "off" && {env.SITE} != "soon" && {path} == "/"`
	redir @resume_off /experiments 302
	reverse_proxy site:8080
}

{$CADDY_SCHEME}{$ADMIN_DOMAIN} {
	import tls_{$TLS_MODE}
	encode zstd gzip
	reverse_proxy oauth2-proxy:4180 {
		# oauth2-proxy matches its skip-auth routes against X-Forwarded-Uri:
		# never let a client choose it, or "/api/health" would open everything.
		header_up X-Forwarded-Uri {uri}
	}
}

# Status for dashboards (an Apple TV app, Prometheus): scripts/status.py writes
# the files, compose publishes the port on STATUS_BIND only (keep it a LAN
# address). Open unless STATUS_TOKEN is set; then it wants "Bearer <token>".
(status_files) {
	root * /srv/status
	header Cache-Control "no-store"
	handle /status {
		rewrite * /status.json
		file_server
	}
	handle /metrics {
		rewrite * /metrics.txt
		file_server
	}
	respond 404
}

http://:8090 {
	# {$STATUS_TOKEN} is filled in when Caddy loads this file (a hex token).
	@open expression `"{$STATUS_TOKEN}" == ""`
	@token header Authorization "Bearer {$STATUS_TOKEN}"
	handle @open {
		import status_files
	}
	handle @token {
		import status_files
	}
	respond 401
}
